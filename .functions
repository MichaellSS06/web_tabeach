// Tarifas y reservas de traslados y tours
// CREATE TABLE rutas_traslados (
//     id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
//     origen TEXT NOT NULL,         -- Ej: 'Aeropuerto Piura', 'Aeropuerto Tumbes'
//     destino TEXT NOT NULL,        -- Ej: 'Máncora', 'Punta Sal'
//     vehiculo_clase TEXT NOT NULL, -- Ej: 'Auto', 'Van', 'Sprinter', 'Avanza'
